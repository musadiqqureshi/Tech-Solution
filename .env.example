# ---- Frontend (safe to expose; bundled by Vite) ----
# Supabase publishable/anon key — protected by Row-Level Security.
VITE_SUPABASE_URL=https://gfgvjjwvrobgawsbzotj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Server-only (set in Vercel → Project → Settings → Environment Variables) ----
# Never commit real values. These are used only inside /api functions.
SUPABASE_URL=https://gfgvjjwvrobgawsbzotj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=your-gemini-key-here

# Email lead notifications (guided chatbot → /api/lead). Optional:
# without it, the chatbot falls back to a prefilled mailto button.
# Get a key at https://resend.com (free tier).
RESEND_API_KEY=your-resend-key-here
# Verified sender. Default onboarding@resend.dev only delivers to the
# Resend account owner; use your own domain for real delivery.
RESEND_FROM=Tech Solution Leads <leads@yourdomain.com>
